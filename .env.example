MONGODB_URI=
# Required in production. Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('base64'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Single hardcoded superuser (platform operator). Must match this phone exactly.
ADMIN_PHONENUMBER=
# Argon2 hash only. Escape every $ as \$ or Next.js will treat $v/$m as env vars (breaks Mac vs Windows).
# Generate with: node -e "require('argon2').hash('your-password').then(console.log)"
ADMIN_PASSWORD=
# SMS.ir REST API (https://sms.ir/web-service/)
SMSIR_API_KEY=
SMSIR_LINE_NUMBER=
# Optional Verify template for login OTP (parameter name defaults to CODE)
SMSIR_OTP_TEMPLATE_ID=
SMSIR_OTP_PARAM=CODE
# Optional Verify template for first-login welcome SMS (NAME, LINK)
SMSIR_WELCOME_TEMPLATE_ID=
# TEMP: when true, the login screen shows the OTP. Remove this flag and
# revealLoginCode() in src/server/auth.ts when the code must stay off the client.
SHOW_LOGIN_NUMBER=false
NEXT_PUBLIC_APP_URL=
# GA4 Measurement ID (G-XXXXXXXX). Leave empty to skip the tag.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Google Search Console HTML-tag content (the token only, not the full meta tag).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Zarinpal merchant for storefront + subscription. Without it, local/dev uses a mock pay page.
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=false
# Public social links (shop footer + Telegram captions)
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_TELEGRAM_URL=
NEXT_PUBLIC_LINKEDIN_URL=
# Telegram channel publishing (platform admin). Bot must be channel admin with Post messages.
TELEGRAM_BOT_TOKEN=
# Public: @mychannel  |  Private: numeric id like -1001234567890  |  or https://t.me/mychannel
TELEGRAM_CHANNEL_ID=
# Optional static invite if createChatInviteLink is unavailable
TELEGRAM_CHANNEL_INVITE_LINK=
# Set to 1 only to dry-run (log + fake success) without calling Telegram
TELEGRAM_MOCK=
# Supabase Storage (cloth / product images). Server uses SECRET key for uploads.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=
# Public storage bucket name (created automatically if missing)
SUPABASE_STORAGE_BUCKET=basar
# Optional. Used for higher-quality AI product photo edits. Without it, studio/white-background still works locally.
OPENAI_API_KEY=
# Photoroom Image Editing API (https://docs.photoroom.com/)
PHOTOROOM_API_KEY=
# Leave true while testing: watermarked sandbox calls. Set false for the live key.
PHOTOROOM_SANDBOX=true

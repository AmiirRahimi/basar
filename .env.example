MONGODB_URI=
# Required in production. Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('base64'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ADMIN_PHONENUMBER=
# Argon2 hash only. Escape every $ as \$ or Next.js will treat $v/$m as env vars (breaks Mac vs Windows).
# Generate with: node -e "require('argon2').hash('your-password').then(console.log)"
ADMIN_PASSWORD=
MELLI_PAYAMAK_TOKEN=
MELLI_PAYAMAK_BASE_URL=https://console.melipayamak.com
MELLI_PAYAMAK_PATH=/api/send/otp/
MELLI_PAYAMAK_SMS_PATH=/api/send/simple/
MELLI_PAYAMAK_FROM=
# When true, counting login also shows the OTP in a toast (in addition to SMS in production).
SHOW_LOGIN_NUMBER=false
NEXT_PUBLIC_APP_URL=
# GA4 Measurement ID (G-XXXXXXXX). Leave empty to skip the tag.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Google Search Console HTML-tag content (the token only, not the full meta tag).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Zarinpal merchant for storefront + subscription. Without it, local/dev uses a mock pay page.
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=false
# Public social links (shop footer + Telegram captions)
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_TELEGRAM_URL=
NEXT_PUBLIC_LINKEDIN_URL=
# Telegram channel publishing (platform admin). Bot must be channel admin.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
# Optional static invite if createChatInviteLink is unavailable
TELEGRAM_CHANNEL_INVITE_LINK=
LIARA_BUCKET_ACCESS=
LIARA_BUCKET_SECRET=
LIARA_BUCKET_NAME=basar-bucket
LIARA_BUCKET_DOMAIN=https://basar-bucket.ir
NEXT_PUBLIC_BUCKET_URL=https://baasar-bucket.ir
# Optional. Used for higher-quality AI product photo edits. Without it, studio/white-background still works locally.
OPENAI_API_KEY=
# Photoroom Image Editing API (https://docs.photoroom.com/)
PHOTOROOM_API_KEY=
# Leave true while testing: watermarked sandbox calls. Set false for the live key.
PHOTOROOM_SANDBOX=true
